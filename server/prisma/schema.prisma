// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

model DevelopmentRequester {
  id           String        @id @default(uuid())
  displayName  String
  email        String        @unique
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tickets      Ticket[]
  ticketEvents TicketEvent[]
}

model RelatedSystem {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]
}

model Ticket {
  id                String               @id @default(uuid())
  ticketNumber      String               @unique
  requesterId       String
  categoryId        Int
  relatedSystemId   String
  summary           String
  description       String
  requestedPriority String               // Low | Medium | High | Urgent
  currentStatus     String               @default("New")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  requester         DevelopmentRequester @relation(fields: [requesterId], references: [id])
  category          Category             @relation(fields: [categoryId], references: [id])
  relatedSystem     RelatedSystem        @relation(fields: [relatedSystemId], references: [id])
  ticketEvents      TicketEvent[]

  @@index([requesterId, createdAt])
  @@index([requesterId, currentStatus])
  @@index([categoryId])
  @@index([relatedSystemId])
}

model TicketEvent {
  id          String                @id @default(uuid())
  ticketId    String
  actorId     String?
  eventType   String                // e.g. TICKET_CREATED
  payloadJson Json?
  createdAt   DateTime              @default(now())

  ticket      Ticket                @relation(fields: [ticketId], references: [id])
  actor       DevelopmentRequester? @relation(fields: [actorId], references: [id])

  @@index([ticketId, createdAt])
}

model TicketSequence {
  year      Int      @id
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
}